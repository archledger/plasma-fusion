[Desktop Entry]
Type=Application
Name=Plasma Fusion: Copy Text Overlay
Comment=Selection overlay for copying text from the screen (started with the session)
Exec=@PF_HELPER_DIR@/plasma-fusion-copytext-overlay
Icon=document-scan
NoDisplay=true
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
