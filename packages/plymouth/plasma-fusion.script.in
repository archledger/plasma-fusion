/*
 * Plasma Fusion boot splash and disk unlock, for plymouth's script plugin.
 * Design: design/boards/Splash.dc.html (the log-in splash), with the unlock form of
 * design/boards/Boot.dc.html.
 *
 * SPDX-FileCopyrightText: 2026 Wisbendji Fimerlus <archledger236@gmail.com>
 * SPDX-License-Identifier: GPL-2.0-or-later
 *
 * The blurred Dusk Ridge wallpaper, the three-circle logo inside two orbit rings with three
 * dots travelling along the outer ring, "Welcome back, <name>", a progress bar driven by
 * plymouth's boot progress, "Starting up", and the "Plasma Fusion" mark in the bottom left
 * corner. Shutdown, reboot and system updates show their own heading instead of the greeting.
 * When a disk passphrase (or a PIN, recovery key or any other secret) is asked, the prompt,
 * the field with its bullets and the disk name take the place of the greeting, with "Esc shows
 * boot messages" and the keyboard layout in the bottom corners.
 *
 * All text is pre-rendered by generators/plymouth/gen_plymouth.py: fixed texts as images, the
 * greeting by tools/system/plymouth-install.sh on the target (the owner's name), text only
 * known at boot (disk name, other prompts, messages, answers, the layout label) from glyph
 * atlases. The generated tables are inserted at the marker below. Every image exists for
 * several scale factors; the one that fits the screen is chosen at start and whenever a display
 * is added or removed.
 *
 * Variables inside functions are written local.x / global.x on purpose: a bare name that
 * already exists globally would refer to the global.
 */

#@PF_DATA@

# ------------------------------------------------------------------------ state

# Black until the background has faded in (the firmware logo before plymouth is on black).
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
Plymouth.SetRefreshRate(30);

global.FPS = 30;
global.FADE = 15;                 # frames of the fade-in (0.5 s)
global.st.mode = "splash";        # splash | password | question
global.st.frame = 0;
global.st.fade = 1;
global.st.prompt = "#none";
global.st.bullets = 0;
global.st.answer = "";
global.st.message = "";
global.st.capslock = 0;
global.st.answered = "#none";      # the last password prompt that was answered
global.st.retry = 0;              # the same prompt asked again: the answer was wrong
global.st.frame_caret = 0;
global.st.title = NULL;
global.st.disk = 0;
global.st.update = -1;            # system update progress in %, -1 when not updating
global.st.progress = 0;           # boot progress 0..1 (never goes back)
global.st.bodyw = -1;             # width of the stretched bar body
global.st.bgw = -1;
global.st.bgh = -1;
global.st.sid = "";
global.G = [];                    # geometry: x, y, w, h, s, sid, fx, fy, bottom, right
global.L = [];                    # layout tables of the current scale
global.img = [];                  # images of the current scale
global.cache = [];                # glyph images cropped from the atlases
global.spr = [];                  # fixed sprites
global.txt = [];                  # glyph sprite runs

# Fade in from black at boot, shutdown and reboot; a mode change during the boot (system
# updates) re-runs this script and must not flash.
if (Plymouth.GetMode() == "boot" || Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot")
    global.st.fade = 0;

global.Z_BG = 1;
global.Z_RINGS = 5;
global.Z_DOTS = 6;
global.Z_BASE = 10;
global.Z_FORM = 20;
global.Z_TEXT = 30;

# Fixed text sprites: the form's prompt lines and 13 px lines, and the headings.
global.text_keys = ["t-passphrase", "t-recovery", "t-either", "t-verify", "t-pin", "t-answer",
                    "t-starting", "t-encrypted", "t-capslock", "t-wrong", "t-wrong-recovery",
                    "t-wrong-pin", "t-dontoff"];
global.heading_keys = ["greeting", "h-shutdown", "h-reboot", "h-updates", "h-upgrade",
                       "h-firmware", "h-reset"];

# ------------------------------------------------------------------------ strings

# Position of needle in hay, or -1.
fun pf_find(hay, needle) {
    local.n = String(needle).Length();
    local.h = String(hay).Length();
    for (local.i = 0; local.i + local.n <= local.h; local.i++) {
        if (String(hay).SubString(local.i, local.i + local.n) == needle)
            return local.i;
    }
    return -1;
}

# Position of the last needle in hay, or -1.
fun pf_find_last(hay, needle) {
    local.n = String(needle).Length();
    for (local.i = String(hay).Length() - local.n; local.i >= 0; local.i--) {
        if (String(hay).SubString(local.i, local.i + local.n) == needle)
            return local.i;
    }
    return -1;
}

# 1 or 0 ("a && b" yields one of its operands, not a number).
fun pf_b(value) {
    if (value) return 1;
    return 0;
}

fun pf_ends_with(text, tail) {
    local.n = String(tail).Length();
    local.h = String(text).Length();
    if (local.n > local.h) return 0;
    return String(text).SubString(local.h - local.n, local.h) == tail;
}

# Remove trailing spaces and one trailing colon.
fun pf_trim(text) {
    local.t = text;
    local.h = String(local.t).Length();
    while (local.h > 0 && String(local.t).CharAt(local.h - 1) == " ") {
        local.t = String(local.t).SubString(0, local.h - 1);
        local.h--;
    }
    if (local.h > 0 && String(local.t).CharAt(local.h - 1) == ":") {
        local.t = String(local.t).SubString(0, local.h - 1);
        local.h--;
    }
    while (local.h > 0 && String(local.t).CharAt(local.h - 1) == " ") {
        local.t = String(local.t).SubString(0, local.h - 1);
        local.h--;
    }
    return local.t;
}

fun pf_replace_all(text, from, to) {
    local.out = "";
    local.rest = text;
    local.n = String(from).Length();
    local.p = pf_find(local.rest, from);
    while (local.p >= 0) {
        local.out = local.out + String(local.rest).SubString(0, local.p) + to;
        local.rest = String(local.rest).SubString(local.p + local.n, String(local.rest).Length());
        local.p = pf_find(local.rest, from);
    }
    return local.out + local.rest;
}

# ------------------------------------------------------------------------ glyph runs

# Split a UTF-8 string into glyph keys of a character set. Characters without a glyph become
# one "?" (a run of unknown bytes is one character as far as the reader is concerned).
fun pf_keys(text, charset) {
    local.keys = [];
    local.n = 0;
    local.len = String(text).Length();
    local.unknown = 0;
    local.cs = pf.charset[charset];
    local.i = 0;
    while (local.i < local.len) {
        local.key = NULL;
        local.step = 1;
        local.c = String(text).CharAt(local.i);
        # (The script scanner knows only the escapes \n \e \0 and \"; "\t" would be "t".)
        if (local.c == "\n") local.c = " ";
        if (local.cs[local.c]) {
            local.key = local.c;
        } else if (local.i + 1 < local.len && local.cs[String(text).SubString(local.i, local.i + 2)]) {
            local.key = String(text).SubString(local.i, local.i + 2);
            local.step = 2;
        } else if (local.i + 2 < local.len && local.cs[String(text).SubString(local.i, local.i + 3)]) {
            local.key = String(text).SubString(local.i, local.i + 3);
            local.step = 3;
        }
        if (local.key) {
            local.keys[local.n] = local.key;
            local.n++;
            local.unknown = 0;
        } else if (!local.unknown) {
            local.keys[local.n] = "?";
            local.n++;
            local.unknown = 1;
        }
        local.i += local.step;
    }
    local.keys.n = local.n;
    return local.keys;
}

fun pf_advance(role, key) {
    local.a = pf.adv[pf.role[role].weight][key];
    if (!local.a) return 0;
    return local.a;
}

fun pf_kerning(role, prev, key) {
    if (prev == "") return 0;
    local.k = pf.kern[pf.role[role].weight][prev + key];
    if (!local.k) return 0;
    return local.k;
}

# Width in device px of the first n keys.
fun pf_run_width(role, keys, n) {
    local.k = pf.role[role].size * G.s / 1000;
    local.w = 0;
    local.prev = "";
    for (local.i = 0; local.i < n; local.i++) {
        local.w += (pf_kerning(role, local.prev, keys[local.i]) + pf_advance(role, keys[local.i])) * local.k;
        local.prev = keys[local.i];
    }
    return local.w;
}

fun pf_glyph(role, key, phase) {
    local.ck = role + "|" + phase + "|" + key;
    if (!global.cache[local.ck]) {
        local.A = L.atlas[role];
        local.index = pf.charset[pf.role[role].charset][key] - 1;
        global.cache[local.ck] = img.atlas[role].Crop(local.index * local.A.cellw, phase * local.A.cellh,
                                                       local.A.cellw, local.A.cellh);
    }
    return global.cache[local.ck];
}

# Keys that fit in maxw device px, ending with an ellipsis when cut ("from_start" keeps the end
# of the text instead, for a typed answer).
fun pf_fit(role, keys, maxw, from_start) {
    if (pf_run_width(role, keys, keys.n) <= maxw) return keys;
    local.ell = "…";
    if (!pf.charset[pf.role[role].charset][local.ell]) local.ell = "-";
    local.ew = pf_advance(role, local.ell) * pf.role[role].size * G.s / 1000;
    local.out = [];
    if (from_start) {
        local.first = 0;
        while (local.first < keys.n) {
            local.rest = [];
            for (local.i = local.first; local.i < keys.n; local.i++) local.rest[local.i - local.first] = keys[local.i];
            if (pf_run_width(role, local.rest, keys.n - local.first) + local.ew <= maxw) break;
            local.first++;
        }
        local.out[0] = local.ell;
        for (local.i = local.first; local.i < keys.n; local.i++) local.out[local.i - local.first + 1] = keys[local.i];
        local.out.n = keys.n - local.first + 1;
        return local.out;
    }
    local.n = keys.n;
    while (local.n > 0 && pf_run_width(role, keys, local.n) + local.ew > maxw) local.n--;
    while (local.n > 0 && keys[local.n - 1] == " ") local.n--;
    for (local.i = 0; local.i < local.n; local.i++) local.out[local.i] = keys[local.i];
    local.out[local.n] = local.ell;
    local.out.n = local.n + 1;
    return local.out;
}

# Sprites for a line of text. x is the pen start, or the centre when centred is 1; baseline is
# in device px. Returns a hash of sprites with .n and .width.
fun pf_text(role, text, x, baseline, maxw, centred, from_start) {
    local.A = L.atlas[role];
    local.keys = pf_fit(role, pf_keys(text, pf.role[role].charset), maxw, from_start);
    local.k = pf.role[role].size * G.s / 1000;
    local.w = pf_run_width(role, local.keys, local.keys.n);
    local.pen = x;
    if (centred) local.pen = x - local.w / 2;
    local.run = [];
    local.m = 0;
    local.prev = "";
    for (local.i = 0; local.i < local.keys.n; local.i++) {
        local.key = local.keys[local.i];
        local.pen += pf_kerning(role, local.prev, local.key) * local.k;
        if (local.key != " ") {
            local.ix = Math.Int(local.pen);
            local.ph = Math.Int((local.pen - local.ix) * local.A.phases + 0.5);
            if (local.ph >= local.A.phases) {
                local.ph = 0;
                local.ix++;
            }
            local.sp = Sprite(pf_glyph(role, local.key, local.ph));
            local.sp.SetX(local.ix - local.A.ox);
            local.sp.SetY(baseline - local.A.base);
            local.sp.SetZ(Z_TEXT);
            local.sp.SetOpacity(0);
            local.run[local.m] = local.sp;
            local.m++;
        }
        local.pen += pf_advance(role, local.key) * local.k;
        local.prev = local.key;
    }
    local.run.n = local.m;
    local.run.width = local.w;
    return local.run;
}

fun pf_run_opacity(run, o) {
    if (!run) return;
    for (local.i = 0; local.i < run.n; local.i++) run[local.i].SetOpacity(o);
}

# ------------------------------------------------------------------------ geometry

fun pf_geometry() {
    # All displays show the same picture, centred on the largest one; lay out for the area that
    # every display shows so nothing is cut off on the smaller ones.
    local.w = Window.GetWidth(0);
    local.h = Window.GetHeight(0);
    for (local.i = 1; Window.GetWidth(local.i); local.i++) {
        local.w = Math.Min(local.w, Window.GetWidth(local.i));
        local.h = Math.Min(local.h, Window.GetHeight(local.i));
    }
    if (!local.w || !local.h) {
        local.w = Window.GetWidth();
        local.h = Window.GetHeight();
    }
    global.G.w = local.w;
    global.G.h = local.h;
    global.G.x = Window.GetX();
    global.G.y = Window.GetY();
    local.fit = Math.Min(local.w / 1440, local.h / 900);
    local.k = 0;
    for (local.i = 1; local.i < pf.nscales; local.i++) {
        if (pf.scale[local.i] <= local.fit + 0.06) local.k = local.i;
    }
    global.G.s = pf.scale[local.k];
    global.G.sid = pf.sid[local.k];
    global.G.fx = G.x + Math.Int((local.w - Math.Int(1440 * G.s + 0.5)) / 2);
    global.G.fy = G.y + Math.Int((local.h - Math.Int(900 * G.s + 0.5)) / 2);
    global.G.bottom = G.y + local.h;
    global.G.right = G.x + local.w;
}

fun pf_sprite(name, image, z) {
    if (!global.spr[name]) global.spr[name] = Sprite();
    global.spr[name].SetImage(image);
    global.spr[name].SetZ(z);
    return global.spr[name];
}

# The blurred wallpaper scaled to cover the whole window (the largest display), centred; on a
# portrait screen the sun stays in view at 68 % of the width, as in the log-in splash.
fun pf_background() {
    local.mw = Window.GetWidth();
    local.mh = Window.GetHeight();
    if (local.mw == st.bgw && local.mh == st.bgh) return;
    global.st.bgw = local.mw;
    global.st.bgh = local.mh;
    if (!global.bg_image) global.bg_image = Image(pf.bg.file);
    local.k = Math.Max(local.mw / pf.bg.w, local.mh / pf.bg.h);
    local.w = Math.Int(pf.bg.w * local.k + 0.999);
    local.h = Math.Int(pf.bg.h * local.k + 0.999);
    local.image = bg_image;
    if (local.w != pf.bg.w || local.h != pf.bg.h) local.image = bg_image.Scale(local.w, local.h);
    local.x = Math.Int((local.mw - local.w) / 2);
    if (local.mh > local.mw)
        local.x = -Math.Int(Math.Clamp(pf.bg.sunx * local.k - 0.68 * local.mw, 0, local.w - local.mw));
    pf_sprite("bg", local.image, Z_BG).SetPosition(local.x, Math.Int((local.mh - local.h) / 2), Z_BG);
}

# Load the images of the current scale and position the fixed sprites.
fun pf_layout() {
    pf_geometry();
    pf_background();
    if (G.sid != st.sid) {
        global.st.sid = G.sid;
        global.L = pf_data(G.sid);
        global.cache = [];
        global.img = [];
        img.rings = Image(L.rings.file);
        img.logo = Image(L.logo.file);
        for (local.i = 0; local.i < 3; local.i++) {
            for (local.px = 0; local.px < L.orbit.phases; local.px++) {
                for (local.py = 0; local.py < L.orbit.phases; local.py++)
                    img.dot[local.i]["f" + local.px + local.py] = Image(L["dot" + local.i]["file" + local.px + local.py]);
            }
        }
        for (local.i = 0; heading_keys[local.i]; local.i++)
            img[heading_keys[local.i]] = Image(L[heading_keys[local.i]].file);
        img.pill = Image(L.pill.file);
        img.pillq = Image(L.pillq.file);
        for (local.i = 0; local.i < L.bullet.phases; local.i++) img.bullet[local.i] = Image(L.bullet["file" + local.i]);
        img.caret = Image(L.caret.file);
        img.esc = Image(L.esc.file);
        img.kbd = Image(L.kbd.file);
        img.mark = Image(L.mark.file);
        img.track = Image(L.track.file);
        img.head = Image(L.head.file);
        img.body = Image(L.body.file);
        img.tail = Image(L.tail.file);
        img.atlas["prompt"] = Image(L.atlas["prompt"].file);
        img.atlas["status"] = Image(L.atlas["status"].file);
        img.atlas["chip"] = Image(L.atlas["chip"].file);
        for (local.i = 0; text_keys[local.i]; local.i++) img[text_keys[local.i]] = Image(L[text_keys[local.i]].file);
    }

    pf_sprite("rings", img.rings, Z_RINGS).SetPosition(G.fx + L.rings.x, G.fy + L.rings.y, Z_RINGS);
    pf_sprite("logo", img.logo, Z_BASE).SetPosition(G.fx + L.logo.x, G.fy + L.logo.y, Z_BASE);
    for (local.i = 0; local.i < 3; local.i++) {
        pf_sprite("dot" + local.i, img.dot[local.i]["f00"], Z_DOTS);
        global.st.dotph[local.i] = "";
    }
    for (local.i = 0; heading_keys[local.i]; local.i++) {
        local.key = heading_keys[local.i];
        pf_sprite(local.key, img[local.key], Z_TEXT).SetPosition(G.fx + L[local.key].x, G.fy + L[local.key].y, Z_TEXT);
    }
    pf_sprite("track", img.track, Z_FORM).SetPosition(G.fx + L.track.x, G.fy + L.track.y, Z_FORM);
    pf_sprite("head", img.head, Z_FORM + 1).SetPosition(G.fx + L.head.x, G.fy + L.head.y, Z_FORM + 1);
    # The body is stretched by pf_fill() (from the one-pixel column).
    pf_sprite("body", img.body, Z_FORM + 1).SetPosition(G.fx + L.body.x, G.fy + L.body.y, Z_FORM + 1);
    global.st.bodyw = -1;
    pf_sprite("tail", img.tail, Z_FORM + 1).SetY(G.fy + L.tail.y);
    pf_sprite("pill", img.pill, Z_FORM).SetPosition(G.fx + L.pill.x, G.fy + L.pill.y, Z_FORM);
    pf_sprite("pillq", img.pillq, Z_FORM).SetPosition(G.fx + L.pillq.x, G.fy + L.pillq.y, Z_FORM);
    pf_sprite("caret", img.caret, Z_TEXT).SetY(G.fy + L.caret.y);
    pf_sprite("mark", img.mark, Z_TEXT).SetPosition(G.x + L.mark.x, G.bottom + L.mark.y, Z_TEXT);
    pf_sprite("esc", img.esc, Z_TEXT).SetPosition(G.x + L.esc.x, G.bottom + L.esc.y, Z_TEXT);
    pf_sprite("kbd", img.kbd, Z_TEXT).SetY(G.bottom + L.kbd.y);
    for (local.i = 0; text_keys[local.i]; local.i++) {
        local.key = text_keys[local.i];
        pf_sprite(local.key, img[local.key], Z_TEXT).SetPosition(G.fx + L[local.key].x, G.fy + L[local.key].y, Z_TEXT);
    }
    global.bullets = [];
    global.txt = [];
    pf_orbit();
    pf_update_texts();
    pf_show();
}

# ------------------------------------------------------------------------ content

# What systemd-cryptsetup asks: "Please enter passphrase for disk DESCRIPTION (VOLUME) on
# MOUNTPOINT:" and variants (recovery key, "passphrase or recovery key", "(verification)"),
# "Please enter LUKS2 token PIN:", "Please enter TPM2 PIN:", "Please enter security token PIN:".
fun pf_parse_prompt(prompt) {
    local.r = [];
    local.r.title = NULL;        # key of a fixed text, or NULL to draw local.r.text
    local.r.text = pf_trim(prompt);
    local.r.hint = NULL;         # disk name, NULL for the fixed "Encrypted disk"
    local.r.disk = 0;
    local.p = pf_find(prompt, " for disk ");
    if (local.p >= 0) {
        local.r.disk = 1;
        local.head = String(prompt).SubString(0, local.p);
        local.name = pf_trim(String(prompt).SubString(local.p + 10, String(prompt).Length()));
        if (pf_ends_with(local.name, " (verification)")) {
            local.name = String(local.name).SubString(0, String(local.name).Length() - 15);
            local.r.title = "t-verify";
        } else if (pf_find(local.head, "passphrase or recovery key") >= 0) {
            local.r.title = "t-either";
        } else if (pf_find(local.head, "recovery key") >= 0) {
            local.r.title = "t-recovery";
        } else {
            local.r.title = "t-passphrase";
        }
        # NAME is "DESCRIPTION (VOLUME) on MOUNT", "VOLUME on MOUNT", "DESCRIPTION (VOLUME)" or
        # "VOLUME". The volume (luks-UUID) is left out; the description is the partition label
        # or the drive model.
        local.mount = NULL;
        local.desc = NULL;
        local.q = pf_find(local.name, ") on ");
        if (local.q >= 0) {
            local.mount = String(local.name).SubString(local.q + 5, String(local.name).Length());
            local.name = String(local.name).SubString(0, local.q + 1);
        } else {
            local.q = pf_find(local.name, " on ");
            if (local.q >= 0 && pf_find(local.name, " (") < 0) {
                local.mount = String(local.name).SubString(local.q + 4, String(local.name).Length());
                local.name = String(local.name).SubString(0, local.q);
            }
        }
        if (pf_ends_with(local.name, ")")) {
            local.q = pf_find_last(local.name, " (");
            if (local.q > 0) local.desc = String(local.name).SubString(0, local.q);
        }
        if (local.desc && pf_find(local.desc, " ") < 0 && pf_find(local.desc, "_") >= 0) {
            # udev writes ATA/SCSI models with underscores for spaces.
            local.desc = pf_replace_all(local.desc, "_", " ");
        }
        if (local.desc && local.mount) local.r.hint = local.desc + " · " + local.mount;
        else if (local.desc) local.r.hint = local.desc;
        else if (local.mount) local.r.hint = "Encrypted disk · " + local.mount;
    } else if (pf_find(prompt, "token PIN") >= 0 || pf_find(prompt, "TPM2 PIN") >= 0) {
        local.r.title = "t-pin";
        local.r.disk = 1;
    } else if (local.r.text == "") {
        local.r.title = "t-passphrase";
        local.r.disk = 1;
    }
    return local.r;
}

# The heading in the greeting's place: the greeting at boot, else the mode's own.
fun pf_heading() {
    local.m = Plymouth.GetMode();
    if (local.m == "shutdown") return "h-shutdown";
    if (local.m == "reboot") return "h-reboot";
    if (local.m == "system-upgrade") return "h-upgrade";
    if (local.m == "firmware-upgrade") return "h-firmware";
    if (local.m == "system-reset") return "h-reset";
    if (local.m == "updates" || st.update >= 0) return "h-updates";
    return "greeting";
}

# What the bar shows (0..1), or -1 for no bar: the update's progress during system updates,
# the boot progress at boot, none at shutdown and reboot.
fun pf_bar_value() {
    if (st.update >= 0) return Math.Clamp(st.update, 0, 100) / 100;
    if (pf_heading() == "greeting") return st.progress;
    return -1;
}

# Rebuild the glyph runs that depend on the prompt, the scale, the answer or a message.
fun pf_update_texts() {
    global.txt = [];
    local.lines = L.lines;
    if (st.mode == "password" || st.mode == "question") {
        local.r = pf_parse_prompt(st.prompt);
        global.st.title = local.r.title;
        global.st.disk = local.r.disk;
        if (!local.r.title) {
            if (local.r.text == "" && st.mode == "question") global.st.title = "t-answer";
            else txt.prompt = pf_text("prompt", local.r.text, G.fx + local.lines.cx, G.fy + local.lines.prompt,
                                      local.lines.maxw, 1, 0);
        }
        if (local.r.hint) txt.hint = pf_text("status", local.r.hint, G.fx + local.lines.cx, G.fy + local.lines.hint,
                                            local.lines.hintmaxw, 1, 0);
        if (st.mode == "question") txt.answer = pf_text("prompt", st.answer, G.fx + L.answer.x0,
                                                        G.fy + L.answer.base, L.answer.maxw, 0, 1);
        # Messages under the form.
        if (st.message != "") txt.message = pf_text("prompt", st.message, G.fx + local.lines.cx,
                                                    G.fy + local.lines.message, local.lines.maxw, 1, 0);
    } else {
        # The status line: the update's percentage (and message), else a message ("Starting up"
        # is a fixed image).
        local.line = "";
        if (st.update >= 0) {
            local.line = Math.Int(st.update + 0.5) + " %";
            if (st.message != "") local.line = local.line + " · " + st.message;
        } else if (st.message != "") {
            local.line = st.message;
        }
        if (local.line != "") txt.status = pf_text("status", local.line, G.fx + local.lines.cx,
                                                   G.fy + local.lines.status, local.lines.maxw, 1, 0);
    }
    if (global.PFKeyboardLayout) {
        # Right-align the label 40 px from the right edge, the keyboard icon 6 px before it.
        local.keys = pf_keys(PFKeyboardLayout, pf.role["chip"].charset);
        local.left = G.right + L.kbd.right - pf_run_width("chip", local.keys, local.keys.n);
        global.txt.chip = pf_text("chip", PFKeyboardLayout, local.left, G.bottom + L.kbd.base, 200 * G.s, 0, 0);
        spr.kbd.SetX(Math.Int(local.left - L.kbd.gap - L.kbd.size + 0.5) + L.kbd.x);
    }
}

# The bar's fill up to the current value: head, a stretched one-pixel body, tail.
fun pf_fill() {
    local.B = L.bar;
    local.v = pf_bar_value();
    local.o = st.fade * pf_b(st.mode == "splash");
    local.end = Math.Min(Math.Int(B.x0 + local.v * B.w + 0.5), B.end);
    if (local.v < 0 || local.end - B.left < B.minw) local.o = 0;
    spr.track.SetOpacity(st.fade * pf_b(st.mode == "splash" && local.v >= 0));
    spr.head.SetOpacity(local.o);
    spr.tail.SetOpacity(local.o);
    local.bw = local.end - B.tail - L.body.x;
    if (local.o > 0 && local.bw > 0) {
        if (local.bw != st.bodyw) {
            spr.body.SetImage(img.body.Scale(local.bw, L.body.h));
            global.st.bodyw = local.bw;
        }
        spr.body.SetOpacity(local.o);
    } else {
        spr.body.SetOpacity(0);
    }
    if (local.o > 0) spr.tail.SetX(G.fx + local.end - B.tail);
}

# Opacity of everything for the current mode.
fun pf_show() {
    local.f = st.fade;
    local.form = pf_b(st.mode == "password" || st.mode == "question");
    local.col = 1 - local.form;
    local.pw = pf_b(st.mode == "password");
    spr.bg.SetOpacity(local.f);
    spr.rings.SetOpacity(local.f);
    spr.logo.SetOpacity(local.f);
    for (local.i = 0; local.i < 3; local.i++) spr["dot" + local.i].SetOpacity(local.f);
    # The column under the emblem: heading, bar, status line.
    local.h = pf_heading();
    for (local.i = 0; heading_keys[local.i]; local.i++)
        spr[heading_keys[local.i]].SetOpacity(local.f * pf_b(local.col && heading_keys[local.i] == local.h));
    pf_fill();
    for (local.i = 0; text_keys[local.i]; local.i++) spr[text_keys[local.i]].SetOpacity(0);
    if (local.col && local.h == "greeting" && st.message == "") spr["t-starting"].SetOpacity(local.f);
    if (local.col && st.update >= 0) spr["t-dontoff"].SetOpacity(local.f);
    pf_run_opacity(txt.status, local.f * local.col);
    spr.mark.SetOpacity(local.f * local.col);
    # The form.
    spr.pill.SetOpacity(local.f * local.pw);
    spr.pillq.SetOpacity(local.f * pf_b(st.mode == "question"));
    spr.esc.SetOpacity(local.f * local.form);
    spr.kbd.SetOpacity(local.f * pf_b(local.form && global.PFKeyboardLayout));
    pf_run_opacity(txt.chip, local.f * local.form);
    if (local.form && st.title) spr[st.title].SetOpacity(local.f);
    pf_run_opacity(txt.prompt, local.f * local.form);
    pf_run_opacity(txt.answer, local.f * pf_b(st.mode == "question"));
    # Under the field: Caps Lock warning, else "Wrong ..., try again" when the prompt is asked
    # again, else the disk name.
    local.caps = pf_b(local.pw && st.capslock);
    local.wrong = pf_b(local.pw && !local.caps && st.retry);
    local.plain = pf_b(local.form && !local.caps && !local.wrong);
    pf_run_opacity(txt.hint, local.f * local.plain);
    if (local.plain && st.disk && !txt.hint) spr["t-encrypted"].SetOpacity(local.f);
    if (local.caps) spr["t-capslock"].SetOpacity(local.f);
    if (local.wrong) {
        local.key = "t-wrong";
        if (st.title == "t-recovery") local.key = "t-wrong-recovery";
        if (st.title == "t-pin") local.key = "t-wrong-pin";
        spr[local.key].SetOpacity(local.f);
    }
    pf_run_opacity(txt.message, local.f);
    pf_update_bullets();
}

fun pf_update_bullets() {
    local.n = 0;
    if (st.mode == "password") local.n = Math.Min(st.bullets, L.bullet.max);
    for (local.i = 0; local.i < local.n || global.bullets[local.i]; local.i++) {
        if (!global.bullets[local.i]) {
            global.bullets[local.i] = Sprite();
            global.bullets[local.i].SetZ(Z_TEXT);
        }
        local.pen = L.bullet.x0 + local.i * L.bullet.pitch;
        local.ix = Math.Int(local.pen);
        local.ph = Math.Int((local.pen - local.ix) * L.bullet.phases + 0.5);
        if (local.ph >= L.bullet.phases) {
            local.ph = 0;
            local.ix++;
        }
        global.bullets[local.i].SetImage(img.bullet[local.ph]);
        global.bullets[local.i].SetX(G.fx + local.ix + L.bullet.x);
        global.bullets[local.i].SetY(G.fy + L.bullet.base + L.bullet.y);
        global.bullets[local.i].SetOpacity(st.fade * pf_b(local.i < local.n));
    }
    # The text cursor follows the last bullet (or the typed answer).
    local.cx = L.caret.x0;
    if (local.n > 0) local.cx = L.bullet.x0 + local.n * L.bullet.pitch + L.caret.after;
    if (st.mode == "question") {
        local.cx = L.answer.x0;
        if (txt.answer) local.cx = local.cx + txt.answer.width + L.caret.gap;
    }
    spr.caret.SetX(G.fx + Math.Int(local.cx + 0.5));
    global.st.caret_x = local.cx;
}

# The three dots travel together along the outer ring, clockwise, one turn in
# pf.orbit.period seconds, from the board's positions. Each is drawn at the nearest of
# L.orbit.phases x L.orbit.phases sub-pixel positions.
fun pf_orbit() {
    local.t = st.frame / FPS;
    local.n = L.orbit.phases;
    for (local.i = 0; local.i < 3; local.i++) {
        local.D = L["dot" + local.i];
        local.a = (pf.orbit.angle[local.i] + 360 * local.t / pf.orbit.period) * Math.Pi / 180;
        local.x = G.fx + L.orbit.cx + L.orbit.r * Math.Sin(local.a) - local.D.d / 2;
        local.y = G.fy + L.orbit.cy - L.orbit.r * Math.Cos(local.a) - local.D.d / 2;
        local.ix = Math.Int(local.x);
        local.px = Math.Int((local.x - local.ix) * local.n + 0.5);
        if (local.px >= local.n) {
            local.px = 0;
            local.ix++;
        }
        local.iy = Math.Int(local.y);
        local.py = Math.Int((local.y - local.iy) * local.n + 0.5);
        if (local.py >= local.n) {
            local.py = 0;
            local.iy++;
        }
        local.key = "f" + local.px + local.py;
        if (st.dotph[local.i] != local.key) {
            spr["dot" + local.i].SetImage(img.dot[local.i][local.key]);
            global.st.dotph[local.i] = local.key;
        }
        spr["dot" + local.i].SetPosition(local.ix - local.D.pad, local.iy - local.D.pad, Z_DOTS);
    }
}

# ------------------------------------------------------------------------ callbacks

fun pf_refresh() {
    global.st.frame++;
    pf_orbit();
    if (st.fade < 1) {
        # Ease out (cubic) over FADE frames.
        local.u = 1 - Math.Min(1, st.frame / FADE);
        global.st.fade = 1 - local.u * local.u * local.u;
        pf_show();
    }
    if (st.mode == "password" || st.mode == "question") {
        # Caret blinks like Qt's (about 530 ms on, 530 ms off).
        spr.caret.SetOpacity(st.fade * pf_b(Math.Int((st.frame - st.frame_caret) / 16) % 2 == 0));
        if (st.mode == "password") {
            local.caps = Plymouth.GetCapslockState();
            if (local.caps != st.capslock) {
                global.st.capslock = local.caps;
                pf_show();
            }
        }
    } else {
        spr.caret.SetOpacity(0);
    }
}

fun pf_boot_progress(duration, progress) {
    if (progress > st.progress) {
        global.st.progress = progress;
        pf_fill();
    }
}

fun pf_display_normal() {
    if (st.mode == "password") global.st.answered = st.prompt;
    if (st.mode != "splash") {
        global.st.mode = "splash";
        global.st.prompt = "#none";
        pf_update_texts();
    }
    pf_show();
}

fun pf_display_password(prompt, bullets) {
    local.changed = (st.mode != "password" || prompt != st.prompt);
    # systemd-cryptsetup asks again with the same prompt when the passphrase was wrong (in
    # between, plymouth shows the splash while the key is checked).
    if (st.mode != "password") global.st.retry = pf_b(prompt == st.answered);
    else if (prompt != st.prompt) global.st.retry = 0;
    global.st.mode = "password";
    global.st.prompt = prompt;
    global.st.bullets = bullets;
    global.st.capslock = Plymouth.GetCapslockState();
    if (local.changed) pf_update_texts();
    pf_show();
    global.st.frame_caret = st.frame;
}

fun pf_display_question(prompt, entry) {
    local.changed = (st.mode != "question" || prompt != st.prompt || entry != st.answer);
    global.st.mode = "question";
    global.st.prompt = prompt;
    global.st.answer = entry;
    if (local.changed) pf_update_texts();
    pf_show();
    global.st.frame_caret = st.frame;
}

fun pf_display_message(text) {
    global.st.message = text;
    pf_update_texts();
    pf_show();
}

fun pf_hide_message(text) {
    if (text == st.message) {
        global.st.message = "";
        pf_update_texts();
        pf_show();
    }
}

fun pf_system_update(progress) {
    global.st.update = progress;
    pf_update_texts();
    pf_show();
}

fun pf_quit() {
    # Leave the splash on screen for whatever comes next (plymouth may keep the last frame).
    global.st.mode = "splash";
    global.st.message = "";
    global.st.fade = 1;
    pf_update_texts();
    pf_show();
}

pf_layout();
if (Plymouth.GetMode() == "updates" || Plymouth.GetMode() == "system-upgrade"
    || Plymouth.GetMode() == "firmware-upgrade" || Plymouth.GetMode() == "system-reset") {
    pf_system_update(0);
}

Plymouth.SetRefreshFunction(pf_refresh);
Plymouth.SetBootProgressFunction(pf_boot_progress);
Plymouth.SetDisplayNormalFunction(pf_display_normal);
Plymouth.SetDisplayPasswordFunction(pf_display_password);
Plymouth.SetDisplayQuestionFunction(pf_display_question);
Plymouth.SetDisplayMessageFunction(pf_display_message);
Plymouth.SetHideMessageFunction(pf_hide_message);
Plymouth.SetSystemUpdateFunction(pf_system_update);
Plymouth.SetDisplayHotplugFunction(pf_layout);
Plymouth.SetQuitFunction(pf_quit);
