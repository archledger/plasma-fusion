[Plymouth Theme]
Name=Plasma Fusion
Description=Plasma Fusion boot splash with the greeting and the disk unlock prompt
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/plasma-fusion
ScriptFile=/usr/share/plymouth/themes/plasma-fusion/plasma-fusion.script

# Keyboard layout label shown next to the unlock field. tools/system/plymouth-install.sh
# writes it from /etc/vconsole.conf; without it the label is not shown.
[script-env-vars]
