# Plasma Fusion Light: what the Global Theme sets (read by libklookandfeel).
# Every value names a package installed by another Plasma Fusion part; a name that is not
# installed is skipped by Plasma and the current value stays.
#
# No fonts and no cursor here: every Global Theme apply (also the automatic light/dark switch
# and the quick-settings Dark tile) writes the theme's values to ~/.config/kdedefaults and
# deletes the user's own keys for them (KLookAndFeelManager::writeNewDefaults, plasma-workspace
# 6.7.5), which would undo the user's font size or cursor at every switch.
# tools/device/fusion-config.sh sets Manrope and PlasmaFusion-cursors once instead.

[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=PlasmaFusionLight

[kdeglobals][Icons]
Theme=PlasmaFusion

[plasmarc][Theme]
name=plasma-fusion-light

# The compiled decoration (plasma-fusion-decoration), with no Aurorae theme. Where the plugin is
# missing, the login check (tools/device/gate) chooses the matching Aurorae theme instead
# (__aurorae__svg__PlasmaFusionLight, or ...-Left for left circles) and switches back once it is installed.
[kwinrc][org.kde.kdecoration2]
library=org.plasmafusion.decoration
theme=
NoPlugin=false
# Applied only while kwinrc [org.kde.kdecoration2] BorderSizeAuto=false (tools/device/fusion-config.sh).
BorderSize=None

[kwinrc][WindowSwitcher]
LayoutName=org.plasmafusion.switcher

[kwinrc][Windows]
Placement=Centered

[ksplashrc][KSplash]
Theme=org.plasmafusion.dark.desktop

[Wallpaper]
Image=PlasmaFusion

# The Plasma Fusion desktop: Folder View with desktop icons from ~/Desktop (BACKLOG M1), the home
# screen in tablet posture (TABLET2 H1); the layout script sets its keys.
[Desktop][org.kde.plasma.desktop]
Containment=org.plasmafusion.desktop
