[General]
ColorScheme=PlasmaFusionHighContrast
Name=Plasma Fusion High Contrast
shadeSortColumn=true
# Keeps the [Colors:Header][Inactive] values above: without a TintFactor key Plasma 6.7
# replaces them with the Window colours when the scheme is applied.
TintFactor=0

[KDE]
contrast=10
frameContrast=0.5

