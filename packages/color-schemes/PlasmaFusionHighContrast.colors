#
# Plasma Fusion High Contrast: KDE colour scheme for people who need stronger contrast (GAPS G10).
# Black surfaces and white text; every text colour reaches 7:1 (WCAG AAA) on its own background and
# every focus or hover colour at least 4.5:1 (packages/color-schemes/check_contrast.py checks both).
# Keeps the Plasma Fusion blue (#8ab8ff, the dark scheme's link and focus colour) for selections and
# links; keyboard focus is yellow, as in most high-contrast themes, so it never looks like a
# selection. Use it with the Plasma Fusion Dark style and Glass = Solid (the settings module
# switches the glass when this scheme is chosen).

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.35
ContrastEffect=1
Enable=true
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=false
Color=112,111,110
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

