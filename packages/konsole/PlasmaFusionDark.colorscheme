#
# Plasma Fusion Dark terminal colours. Background, text and grey output are the terminal of
# design/boards/TabsSnap.dc.html and Overview.dc.html (#0f1320, #cdd3e4, #8f98b3); the ANSI colours
# come from the design's accent set: teal #3cc4b0 (prompt, cyan), amber #f2a65a (yellow; bold
# warnings use the board's #f2c38a), blue #5b9dff, purple #9b7bf0, success green #3aa65b and the
# close-button red lightened to 5.6:1. Normal colours reach 4.5:1 on the background (black is the
# card colour and is meant for backgrounds).

[General]
Description=Plasma Fusion Dark
Opacity=1
Blur=false
ColorRandomization=false
