#
# Plasma Fusion Light terminal colours: the Plasma Fusion Light view colours (#ffffff, #141827,
# secondary #4d546a) with the design's accent set darkened for white: the colour scheme's status
# colours (#b3262e, #23703b, #8f4f12), link blue #2359c4, visited purple #6b3fb5 and a dark teal.
# Normal colours reach 4.5:1 on white; the bright ones stay above 4.2:1 except bright white.
# The Light boards keep the terminal dark, so the Plasma Fusion profile uses the dark scheme;
# this one is for people who prefer a light terminal.

[General]
Description=Plasma Fusion Light
Opacity=1
Blur=false
ColorRandomization=false
Wallpaper=

[Background]
Color=255,255,255

[BackgroundIntense]
Color=238,240,245

[BackgroundFaint]
Color=255,255,255

