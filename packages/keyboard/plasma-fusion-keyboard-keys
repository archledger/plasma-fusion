# Terminal keys for the on-screen keyboard (research E-phone 4.3 MUST: Esc, Tab and arrows).
#
#   plasma-fusion-keyboard-keys refresh [--dry-run]   (re)build the layouts when plasma-keyboard changed
#   plasma-fusion-keyboard-keys install [--dry-run]   build them now
#   plasma-fusion-keyboard-keys remove                back to plasma-keyboard's own layouts
#   plasma-fusion-keyboard-keys status
#
# plasma-keyboard reads its layouts from the first plasma/keyboard/layouts directory in the data
# directories (~/.local/share first) and nowhere else. This builds ~/.local/share/plasma/keyboard/
# layouts with a link to every system language directory, and a "fallback" directory (the English
# and shared layouts) whose files link to the system's, except symbols.qml: a copy of the installed
# file in which the second symbols page's row of rare symbols (TM, (R), guillemets, curly quotes)
# becomes Esc, Tab and the four arrows (the arrows repeat while held); the six symbols move to the
# long-press lists of the "section" and double-quote keys. The copy is made from the installed file
# each time plasma-keyboard's version changes; if the expected text is not found, the layouts are
# removed (stock keyboard) and the reason is recorded. Records: ~/.local/state/plasma-fusion/keyboard-keys.
import json, os, pathlib, re, shutil, subprocess, sys

SYSTEM = pathlib.Path(os.environ.get("PF_KEYBOARD_SYSTEM", "/usr/share/plasma/keyboard/layouts"))
DATA = pathlib.Path(os.environ.get("XDG_DATA_HOME") or pathlib.Path.home() / ".local/share")
OUT = DATA / "plasma/keyboard/layouts"
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME") or pathlib.Path.home() / ".local/state") / "plasma-fusion"
RECORD = STATE / "keyboard-keys"
MARK = OUT / ".plasma-fusion"   # our directory, never a user's own layouts

OLD_ROW = re.compile(
    r"(?P<indent>[ \t]*)Key \{\s*key: 0x2122\s*text: '™'\s*\}\s*"
    r"Key \{\s*key: 0x00AE\s*text: '®'\s*\}\s*"
    r"Key \{\s*key: Qt\.Key_guillemotleft\s*text: '«'\s*\}\s*"
    r"Key \{\s*key: Qt\.Key_guillemotright\s*text: '»'\s*\}\s*"
    r"(?P<semicolon>Key \{\s*key: Qt\.Key_Semicolon\s*text: \";\"\s*\}\s*)"
    r"Key \{\s*key: 0x201C\s*text: '“'\s*\}\s*"
    r"Key \{\s*key: 0x201D\s*text: '”'\s*\}\s*"
)
SECTION = re.compile(r"(Key \{\s*key: Qt\.Key_section\s*text: \"§\")(\s*\})")
QUOTE = re.compile(r"(Key \{\s*key: +Qt\.Key_QuoteDbl\s*text: '\"')(\s*\})")


def version():
    try:
        out = subprocess.run(["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "plasma-keyboard"],
                             capture_output=True, text=True, timeout=10)
        if out.returncode == 0:
            return out.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    src = SYSTEM / "fallback/symbols.qml"
    return "mtime-%d" % src.stat().st_mtime if src.exists() else ""


def patched(text):
    def keys(m):
        i = m.group("indent")
        def key(code, label, extra=""):
            return (f"{i}Key {{\n{i}    key: {code}\n{i}    displayText: \"{label}\"\n{i}    functionKey: true\n"
                    f"{extra}{i}}}\n")
        arrows = f"{i}    repeat: true\n"
        return (key("Qt.Key_Escape", "Esc") + key("Qt.Key_Tab", "Tab")
                + key("Qt.Key_Left", "←", arrows) + key("Qt.Key_Down", "↓", arrows)
                + key("Qt.Key_Up", "↑", arrows) + key("Qt.Key_Right", "→", arrows)
                + i + m.group("semicolon").strip() + "\n" + i)
    new, n = OLD_ROW.subn(keys, text, count=1)
    if n != 1:
        return None, "the row of rare symbols on the second page was not found"
    new, n = SECTION.subn(lambda m: m.group(1) + "\n                    alternativeKeys: \"§™®\"" + m.group(2), new, count=1)
    if n != 1:
        return None, "the section key was not found"
    new, n = QUOTE.subn(lambda m: m.group(1) + "\n                    alternativeKeys: '\"“”«»'" + m.group(2), new, count=1)
    if n != 1:
        return None, "the double-quote key was not found"
    header = ("// Generated by plasma-fusion-keyboard-keys from " + str(SYSTEM / "fallback/symbols.qml")
              + " (plasma-keyboard " + version() + "):\n// the second page's row of rare symbols is Esc, Tab and the arrows. Do not edit.\n")
    return header + new, ""


def rpmdb_stamp():
    # The rpm database's size and time: unchanged means no package changed (a login checks only this).
    for db in ("/usr/lib/sysimage/rpm/rpmdb.sqlite", "/var/lib/rpm/rpmdb.sqlite"):
        try:
            st = os.stat(db)
            return "%d:%d" % (st.st_size, st.st_mtime_ns)
        except OSError:
            continue
    return ""


def save_record(rec):
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = RECORD.with_suffix(".tmp")
    tmp.write_text(json.dumps(rec, indent=1) + "\n")
    tmp.replace(RECORD)


def load_record():
    try:
        return json.loads(RECORD.read_text())
    except (OSError, ValueError):
        return {}


def ours():
    return OUT.is_dir() and MARK.exists()


def remove(reason, dry):
    if OUT.exists() and not ours():
        print(f"keyboard keys: {OUT} holds layouts that are not Plasma Fusion's; left alone")
        return 1
    if dry:
        print(f"keyboard keys: would remove {OUT} ({reason})")
        return 0
    if ours():
        shutil.rmtree(OUT)
    save_record({"state": "off", "reason": reason, "version": version()})
    print(f"keyboard keys: off ({reason})")
    return 0


def install(dry):
    src = SYSTEM / "fallback/symbols.qml"
    if not src.exists():
        return remove(f"{src} not found", dry)
    if OUT.exists() and not ours():
        print(f"keyboard keys: {OUT} holds layouts that are not Plasma Fusion's; left alone")
        return 1
    text, why = patched(src.read_text())
    if text is None:
        return remove(why, dry)
    if dry:
        print(f"keyboard keys: would build {OUT} for plasma-keyboard {version()}")
        return 0
    tmp = OUT.with_name(OUT.name + ".new")
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    for d in sorted(SYSTEM.iterdir()):
        if d.name == "fallback":
            (tmp / "fallback").mkdir()
            for f in sorted(d.iterdir()):
                if f.name == "symbols.qml":
                    (tmp / "fallback/symbols.qml").write_text(text)
                else:
                    (tmp / "fallback" / f.name).symlink_to(f)
        else:
            (tmp / d.name).symlink_to(d)
    (tmp / ".plasma-fusion").write_text("Built by plasma-fusion-keyboard-keys; removed by its 'remove'.\n")
    if ours():
        shutil.rmtree(OUT)
    tmp.replace(OUT)
    save_record({"state": "on", "version": version(), "rpmdb": rpmdb_stamp()})
    print(f"keyboard keys: on (plasma-keyboard {version()}: Esc, Tab and arrows on the second symbols page)")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    dry = "--dry-run" in argv
    rec = load_record()
    if cmd == "status":
        print(f"keyboard keys: {rec.get('state', 'never built')}, plasma-keyboard {rec.get('version', '-')}"
              + (f" ({rec['reason']})" if rec.get("reason") else "") + (", layouts present" if ours() else ""))
        return 0
    if cmd == "remove":
        return remove("removed on request", dry)
    if cmd == "install":
        return install(dry)
    if cmd == "refresh":
        if rec.get("state") == "on" and ours() and rec.get("rpmdb") and rec.get("rpmdb") == rpmdb_stamp():
            return 0
        if rec.get("state") == "on" and rec.get("version") == version() and ours():
            rec["rpmdb"] = rpmdb_stamp()
            if not dry:
                save_record(rec)
            return 0
        if rec.get("state") == "off" and rec.get("reason") == "removed on request":
            if not dry:
                RECORD.touch()  # newer than the rpm database again: the next login skips the tool
            return 0
        return install(dry)
    print(__doc__ if __doc__ else "usage: plasma-fusion-keyboard-keys refresh|install|remove|status", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
