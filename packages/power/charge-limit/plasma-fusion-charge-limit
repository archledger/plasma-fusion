#
# Plasma Fusion battery charge limit (research D-desktop "Add": a charge limit with a one-tap full
# charge in the quick settings). The same sysfs values PowerDevil's Energy Saving page writes through
# its own helper (charge_control_end_threshold and _start_threshold of the built-in batteries), so that
# page shows what this sets.
#
#   plasma-fusion-charge-limit get        prints "END START" of the first battery with a stop
#                                         threshold (START -1 without a start threshold), then
#                                         "managed=tlp" when TLP sets the thresholds (see below);
#                                         exit 2 when no battery has one. Needs no privileges.
#   plasma-fusion-charge-limit set END    END = 50..100 (whole percent); the start threshold becomes
#                                         END - 5 below 100 and 0 at 100 (charge whenever below).
#                                         Run as root: pkexec, polkit action org.plasmafusion.charge-limit
#                                         (the active local session, no password). Refused (exit 69)
#                                         while TLP sets the thresholds.
#
# TLP (tlp.service enabled, START_/STOP_CHARGE_THRESH_* set in /etc/tlp.conf or /etc/tlp.d) writes the
# thresholds again at boot, on unplugging and on resume, so a limit set here would not stay: the
# quick settings then show TLP's limit without offering changes.
set -euo pipefail
export LC_ALL=C

batteries() {
  local b
  for b in /sys/class/power_supply/*; do
    [ -f "$b/type" ] && [ "$(cat "$b/type")" = Battery ] || continue
    # peripherals (a pen, a mouse) report scope Device
    [ "$(cat "$b/scope" 2>/dev/null || echo System)" = Device ] && continue
    [ -f "$b/charge_control_end_threshold" ] && echo "$b"
  done
}

tlp_manages() {
  command -v tlp >/dev/null 2>&1 || return 1
  systemctl is-enabled --quiet tlp.service 2>/dev/null || return 1
  grep -qsE '^[[:space:]]*(START|STOP)_CHARGE_THRESH_[A-Z0-9]+=' /etc/tlp.conf /etc/tlp.d/*.conf
}

case ${1:-} in
  get)
    b=$(batteries | head -n 1)
    [ -n "$b" ] || exit 2
    end=$(cat "$b/charge_control_end_threshold")
    start=-1
    [ -f "$b/charge_control_start_threshold" ] && start=$(cat "$b/charge_control_start_threshold")
    echo "$end $start"
    if tlp_manages; then
      echo "managed=tlp"
    fi
    ;;
  set)
    end=${2:-}
    # 50..100 written plainly: bash would read a leading zero as octal ("050" is 40).
    [[ $end =~ ^(5[0-9]|[6-9][0-9]|100)$ ]] || { echo "plasma-fusion-charge-limit: END must be 50..100" >&2; exit 64; }
    [ "$(id -u)" = 0 ] || { echo "plasma-fusion-charge-limit: run through pkexec" >&2; exit 77; }
    if tlp_manages; then
      echo "plasma-fusion-charge-limit: TLP sets the charge thresholds (/etc/tlp.conf, /etc/tlp.d)" >&2
      exit 69
    fi
    start=0
    [ "$end" -lt 100 ] && start=$((end - 5))
    found=0
    while IFS= read -r b; do
      found=1
      current=$(cat "$b/charge_control_end_threshold")
      # Keep start below end at every step: raising the limit writes the stop threshold first,
      # lowering it writes the start threshold first.
      if [ -f "$b/charge_control_start_threshold" ] && [ "$end" -lt "$current" ]; then
        printf '%s' "$start" >"$b/charge_control_start_threshold"
        printf '%s' "$end" >"$b/charge_control_end_threshold"
      else
        printf '%s' "$end" >"$b/charge_control_end_threshold"
        [ -f "$b/charge_control_start_threshold" ] && printf '%s' "$start" >"$b/charge_control_start_threshold"
      fi
    done < <(batteries)
    [ "$found" = 1 ] || exit 2
    ;;
  *)
    echo "usage: plasma-fusion-charge-limit get | set END" >&2
    exit 64
    ;;
esac
