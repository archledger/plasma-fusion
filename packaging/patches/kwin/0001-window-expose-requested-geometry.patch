+void Window::notifyRequestedGeometryChanged()
+{
+    if (m_moveResizeGeometry == m_notifiedMoveResizeGeometry) {
+        return;
+    }
+    m_notifiedMoveResizeGeometry = m_moveResizeGeometry;
+    Q_EMIT requestedGeometryChanged();
+}
+
