@@ -3412,6 +3422,7 @@ void Window::resize(const QSizeF &size)

     setMoveResizeGeometry(rect);
     moveResizeInternal(rect, MoveResizeMode::Resize);
+    notifyRequestedGeometryChanged();
 }

