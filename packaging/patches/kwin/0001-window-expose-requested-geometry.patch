 {
     return m_moveResizeOutput;
@@ -3400,6 +3409,7 @@ void Window::move(const QPointF &point)

     setMoveResizeGeometry(rect);
     moveResizeInternal(rect, MoveResizeMode::Move);
+    notifyRequestedGeometryChanged();
 }

