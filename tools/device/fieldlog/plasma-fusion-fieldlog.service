#
# Plasma Fusion field log: records crashes, session restarts, Plasma Fusion QML errors and the memory
# and CPU of plasmashell and KWin in daily use, apart from development noise (docs/parts/fieldlog.md
# in the Plasma Fusion sources). Installed by
#   tools/device/fieldlog/plasma-fusion-fieldlog install [--share DIR] [--dev-dirs LIST]
# which copies the tool to ~/.local/libexec/plasma-fusion/ and enables this unit; "remove" takes both
# away and keeps the recorded state (~/.local/state/plasma-fusion/fieldlog/).
[Unit]
Description=Plasma Fusion field log
PartOf=graphical-session.target
# Ordered before KWin and plasmashell, so that at logout it stops after them and still records a
# hang or crash while they stop. (So not After=graphical-session.target, which comes after them.)
Before=plasma-kwin_wayland.service plasma-plasmashell.service
ConditionEnvironment=XDG_CURRENT_DESKTOP=KDE

[Service]
Type=simple
# The user's own copy first, then a system package's.
ExecSearchPath=%h/.local/libexec/plasma-fusion:/usr/local/libexec/plasma-fusion:/usr/libexec/plasma-fusion
# Without PATH here, ExecSearchPath= becomes the service's PATH (systemd.exec(5)) and coredumpctl,
# journalctl and systemctl are not found.
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=plasma-fusion-fieldlog run
ExecReload=/usr/bin/kill -HUP $MAINPID
# SIGTERM to the tool only: it writes the counts it holds and the day's digest, then stops journalctl.
KillMode=mixed
TimeoutStopSec=20s
Restart=on-failure
RestartSec=30
Slice=background.slice
Nice=10
IOSchedulingClass=idle
# The limit also counts the journal files journalctl reads; without swap the kernel drops that cache
# instead of swapping the tool out (64M with swap: 15 MiB swapped, 3.9 s CPU at start; 96M without:
# none swapped, 0.43 s; the tool itself about 15 MiB; laptop, 2026-10-02).
MemoryMax=96M
MemorySwapMax=0
# Hardening that works in a user unit without a user namespace. PrivateTmp, ProtectSystem and
# ProtectHome would make the user manager add PrivateUsers=yes, which hides the wheel group (the
# system journal) and other processes' environments (the check for a coding agent sharing a crashed
# process's cgroup); tested on Fedora 44, systemd 259, 2026-10-02.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
UMask=0077
SyslogIdentifier=plasma-fusion-fieldlog
# A copy of each day's digest goes to PF_FIELDLOG_SHARE when it is set (install --share DIR).
#Environment=PF_FIELDLOG_SHARE=
# More development folders for the crash classes (install --dev-dirs LIST; default ~/tmp-*).
#Environment=PF_FIELDLOG_DEV_DIRS=

[Install]
WantedBy=graphical-session.target
